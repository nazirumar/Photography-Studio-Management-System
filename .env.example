# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings.production

# Database (PostgreSQL)
DATABASE_URL=postgres://studioflow:studioflow@localhost:5432/studioflow
POSTGRES_DB=studioflow
POSTGRES_USER=studioflow
POSTGRES_PASSWORD=change-me-in-production

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=StudioFlow <noreply@yourdomain.com>

# Celery
CELERY_TASK_ALWAYS_EAGER=False

# Paystack (optional)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# SMS - Termii (optional)
TERMII_API_KEY=
TERMII_SENDER_ID=StudioFlow

# WhatsApp Business API (optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# AI FDE (optional)
AI_ENABLED=true
# Set AI_BASE_URL to use Groq, Together, or any OpenAI-compatible API
# Leave empty for OpenAI direct
AI_BASE_URL=
OPENAI_API_KEY=
AI_PRIMARY_MODEL=gpt-4o
AI_FAST_MODEL=gpt-4o-mini
AI_REASONING_MODEL=o3-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# For Groq (free, fast): AI_BASE_URL=https://api.groq.com/openai/v1
# AI_PRIMARY_MODEL=qwen/qwen3.6-27b
# AI_FAST_MODEL=qwen/qwen3.6-27b
AI_MAX_GRAPH_STEPS=20
AI_REQUEST_TIMEOUT=30
AI_DAILY_USER_LIMIT=100
AI_MONTHLY_STUDIO_LIMIT=10000

# LangSmith (optional, for AI observability)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=studioflow-ai-fde

# External search (optional)
EXTERNAL_SEARCH_ENABLED=false
TAVILY_API_KEY=

# AWS S3 (optional, for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
